generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum Role {
  ADMIN
  INVESTIGATOR
  OFFICER
}

enum CaseStatus {
  OPEN
  UNDER_INVESTIGATION
  ON_HOLD
  CLOSED
  COLD
  ARCHIVED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MatchStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum CriminalStatus {
  ACTIVE
  INACTIVE
  WANTED
  ARCHIVED
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SuspectCaseStatus {
  PRIMARY_SUSPECT
  PERSON_OF_INTEREST
  ACCOMPLICE
  CLEARED
  CONVICTED
}

enum SuspectRole {
  DIRECT_INVOLVEMENT
  POSSIBLE_ASSOCIATE
  ACCOMPLICE
  INFORMANT
  WITNESS
  UNDER_INVESTIGATION
}

enum CriminalRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SurveillanceHitStatus {
  UNACKNOWLEDGED
  INVESTIGATING
  CONFIRMED_SIGHTING
  FALSE_POSITIVE
  RESOLVED
}

// --- MODELS ---

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  passwordHash String?
  role         Role    @default(INVESTIGATOR)
  badgeId      String? @unique
  provider     String  @default("email")
  avatarUrl    String?

  cases            Case[]        @relation("AssignedCases")
  reports          Report[]      @relation("ReportAuthor")
  auditLogs        AuditLog[]
  assignedSuspects CaseSuspect[]
  criminalRecords  CriminalRecord[]
  sessions         Session[]
  accounts         Account[]

  @@map("user")
}

model Case {
  id           String       @id @default(uuid())
  caseNumber   String       @unique @default(cuid()) // Need default for migration of existing rows, usually handled carefully. Let's just use cuid for simplicity in migration.
  title        String
  description  String?
  status       CaseStatus   @default(OPEN)
  priority     CasePriority @default(MEDIUM)
  assignedToId String
  assignedTo   User         @relation("AssignedCases", fields: [assignedToId], references: [id])
  witnesses    Witness[]
  sketches     Sketch[]
  reports      Report[]
  evidences    Evidence[]
  suspects     CaseSuspect[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Witness {
  id          String   @id @default(uuid())
  name        String
  contactInfo String?
  statement   String?  @db.Text
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sketches    Sketch[] // Sketches based on this witness's description
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sketch {
  id                 String              @id @default(uuid())
  imageUrl           String // URL to the generated composite sketch
  description        String?             @db.Text
  caseId             String
  case               Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  witnessId          String? // Optional: if tied to a specific witness
  witness            Witness?            @relation(fields: [witnessId], references: [id], onDelete: SetNull)
  recognitionResults RecognitionResult[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Criminal {
  id                 String              @id @default(uuid())
  criminalId         String              @unique @default(cuid())
  firstName          String
  lastName           String
  alias              String?
  dateOfBirth        DateTime?
  gender             String?
  nationality        String?
  address            String?
  description        String?
  status             CriminalStatus      @default(ACTIVE)
  riskLevel          CriminalRiskLevel   @default(MEDIUM)
  mugshotUrl         String?
  demographics       Json? // e.g., height, eye color, tattoos
  lastKnownLocation  String?
  fingerprintScanUrl String?
  dnaProfileCode     String?
  faceEmbeddingId    String?
  biometricEnrolledAt DateTime?
  watchlistStatus    String?             @default("STANDARD")
  embedding          Unsupported("vector(512)")?
  caseLinks          CaseSuspect[]
  records            CriminalRecord[]
  evidences          Evidence[]          @relation("CriminalEvidence")
  surveillanceHits   SurveillanceHit[]
  recognitionResults RecognitionResult[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model CriminalRecord {
  id              String    @id @default(cuid())
  criminalId      String
  criminal        Criminal  @relation(fields: [criminalId], references: [id], onDelete: Cascade)
  courtCaseNumber String
  offenceType     String
  description     String    @db.Text
  incidentDate    DateTime
  location        String
  courtName       String?
  status          String    @default("Under Investigation")
  outcome         String?
  sentenceDetails String?
  recordedById    String?
  recordedBy      User?     @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([criminalId])
  @@index([courtCaseNumber])
}

model CaseSuspect {
  id                String            @id @default(uuid())
  caseId            String
  criminalId        String
  status            SuspectCaseStatus @default(PERSON_OF_INTEREST)
  role              SuspectRole       @default(UNDER_INVESTIGATION)
  matchConfidence   Float             @default(0.0) // 0.0 - 100.0%
  notes             String?           @db.Text
  assignedOfficerId String?
  assignedOfficer   User?             @relation(fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  case              Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  criminal          Criminal          @relation(fields: [criminalId], references: [id], onDelete: Cascade)
  addedAt           DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([caseId, criminalId])
  @@index([caseId])
  @@index([criminalId])
}

model SurveillanceHit {
  id               String                @id @default(uuid())
  criminalId       String
  sensorId         String // e.g., "ANPR-CAM-11", "CCTV-AI-03"
  sensorName       String? // e.g., "Anna Salai Junction High-Speed ANPR"
  location         String // e.g., "Anna Salai - Mount Road Junction"
  latitude         Float
  longitude        Float
  confidenceScore  Float // 0.0 to 1.0 (e.g. 0.942)
  capturedMediaUrl String?
  details          String?
  status           SurveillanceHitStatus @default(UNACKNOWLEDGED)
  acknowledgedBy   String?
  acknowledgedAt   DateTime?
  criminal         Criminal              @relation(fields: [criminalId], references: [id], onDelete: Cascade)
  createdAt        DateTime              @default(now())

  @@index([criminalId])
  @@index([status])
  @@index([createdAt])
}

model RecognitionResult {
  id         String      @id @default(uuid())
  matchScore Float // Confidence score (e.g., 0.0 to 1.0)
  status     MatchStatus @default(PENDING)
  sketchId   String
  sketch     Sketch      @relation(fields: [sketchId], references: [id], onDelete: Cascade)
  criminalId String
  criminal   Criminal    @relation(fields: [criminalId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Report {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  fileUrl   String? // Optional link to a generated PDF
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReportAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Evidence {
  id            String    @id @default(cuid())
  caseId        String
  criminalId    String?
  title         String?
  description   String?   @db.Text
  category      String?   @default("DOCUMENT") // VIDEO, IMAGE, DOCUMENT, AUDIO, BALLISTIC, BIOMETRIC, PHYSICAL
  source        String?   @default("CRIME_SCENE") // CCTV, CRIME_SCENE, INVESTIGATOR, PHONE_RECORD, LAB_ANALYSIS
  status        String?   @default("VERIFIED") // VERIFIED, UNDER_REVIEW, FLAGGED
  locationFound String?   // Physical retrieval location (e.g. "Main Vault", "Sector 4 Alley")
  fileName      String
  storageKey    String
  mimeType      String
  fileSize      Int
  sha256Hash    String
  fileUrl       String?   // Public/CDN or presigned storage URL
  metadata      Json?     // AI markers, camera IDs, resolution, sensor telemetry
  uploadedBy    String
  uploadedAt    DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  case     Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  criminal Criminal? @relation("CriminalEvidence", fields: [criminalId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([category])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String // e.g., "CASE_CREATED", "MATCH_CONFIRMED"
  entityType String // e.g., "Case", "Sketch"
  entityId   String?
  details    Json? // Additional context about the action
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  issuer                String    @db.Text
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model GenerationJob {
  id        String           @id @default(uuid())
  userId    String?          // Optional: link to User if auth is implemented
  prompt    String           @db.Text
  status    GenerationStatus @default(PENDING)
  imageUrl  String?          @db.Text // URL of the generated image once completed
  error     String?          @db.Text // Error message if failed
  caseId    String?          // Optional: link to Case if generated within a case
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}
