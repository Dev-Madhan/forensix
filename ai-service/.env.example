# Application Environment
APP_ENV=development
APP_NAME=criminal-eye-ai
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Next.js Frontend URL (for CORS)
NEXT_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000","https://forensix-sketch.vercel.app"]

# Server-to-Server Security Secret (Shared with Next.js)
AI_SERVICE_SECRET=change-this-to-a-secure-random-secret-in-production

# Processing & Timeouts
REQUEST_TIMEOUT_SECONDS=30.0
MAX_IMAGE_SIZE_BYTES=15728640

# Phase 7 AI Provider Placeholders (Defaults to local or mock)
LLM_PROVIDER=mock
LLM_API_KEY=
SKETCH_PROVIDER=mock
SKETCH_MODEL=
FACE_PROVIDER=mock
FACE_MODEL=

# Local Model Configurations (RTX 4050 6GB Optimized)
QWEN_BASE_URL=http://127.0.0.1:8001/v1
QWEN_MODEL=Qwen3-8B-GGUF
SD_MODEL_PATH=./models/sd15
CONTROLNET_MODEL_PATH=./models/controlnet/lineart
MEDIAPIPE_MODEL_PATH=./models/mediapipe/face_landmarker.task
OUTPUT_DIR=./outputs


# Phase 5 Storage Reference Configuration (Optional S3/Tigris)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Database Connection (Shared with Next.js / Prisma)
DATABASE_URL=

