generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum Role {
  ADMIN
  INVESTIGATOR
}

enum CaseStatus {
  OPEN
  CLOSED
  COLD
}

enum MatchStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// --- MODELS ---

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  name          String
  passwordHash  String?    
  role          Role       @default(INVESTIGATOR)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  cases         Case[]     @relation("AssignedCases")
  reports       Report[]   @relation("ReportAuthor")
  auditLogs     AuditLog[]
}

model Case {
  id            String     @id @default(uuid())
  title         String
  description   String?
  status        CaseStatus @default(OPEN)
  
  assignedToId  String
  assignedTo    User       @relation("AssignedCases", fields: [assignedToId], references: [id])
  
  witnesses     Witness[]
  sketches      Sketch[]
  reports       Report[]
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Witness {
  id            String     @id @default(uuid())
  name          String
  contactInfo   String?
  statement     String?    @db.Text
  
  caseId        String
  case          Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  sketches      Sketch[]   // Sketches based on this witness's description
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Sketch {
  id            String     @id @default(uuid())
  imageUrl      String     // URL to the generated composite sketch
  description   String?    @db.Text
  
  caseId        String
  case          Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  witnessId     String?    // Optional: if tied to a specific witness
  witness       Witness?   @relation(fields: [witnessId], references: [id], onDelete: SetNull)
  
  recognitionResults RecognitionResult[]
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Criminal {
  id                String     @id @default(uuid())
  firstName         String
  lastName          String
  alias             String?
  mugshotUrl        String?
  demographics      Json?      // e.g., height, eye color, tattoos
  lastKnownLocation String?
  
  recognitionResults RecognitionResult[]
  
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model RecognitionResult {
  id            String      @id @default(uuid())
  matchScore    Float       // Confidence score (e.g., 0.0 to 1.0)
  status        MatchStatus @default(PENDING)
  
  sketchId      String
  sketch        Sketch      @relation(fields: [sketchId], references: [id], onDelete: Cascade)
  
  criminalId    String
  criminal      Criminal    @relation(fields: [criminalId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Report {
  id            String     @id @default(uuid())
  title         String
  content       String     @db.Text
  fileUrl       String?    // Optional link to a generated PDF
  
  caseId        String
  case          Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  authorId      String
  author        User       @relation("ReportAuthor", fields: [authorId], references: [id])
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model AuditLog {
  id            String     @id @default(uuid())
  action        String     // e.g., "CASE_CREATED", "MATCH_CONFIRMED"
  entityType    String     // e.g., "Case", "Sketch"
  entityId      String?
  details       Json?      // Additional context about the action
  
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime   @default(now())
}
